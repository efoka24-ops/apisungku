# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# URL publique de CE service. Sert a construire l'URL de callback a declarer
# dans le dashboard pawaPay : $PUBLIC_URL/v1/callbacks/pawapay
PUBLIC_URL=http://localhost:3000

# ─── Base de donnees ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://apisungku:apisungku@localhost:5432/apisungku?schema=public

# ─── pawaPay ────────────────────────────────────────────────────────────────
# sandbox : https://api.sandbox.pawapay.io | production : https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=remplacer-par-le-token-genere-dans-le-dashboard
PAWAPAY_TIMEOUT_MS=15000
# Secret partage verifiant l'authenticite des callbacks pawaPay entrants.
# Laisser vide desactive la verification (a n'accepter qu'en developpement).
PAWAPAY_CALLBACK_SECRET=

# ─── Signature des requetes (RFC 9421) ──────────────────────────────────────
# Obligatoire des lors que les signatures sont activees sur le compte pawaPay :
# sans elles, toute operation financiere est rejetee (HTTP_SIGNATURE_ERROR).
# Un token qui fuiterait reste alors inexploitable sans la cle privee.
#
# Chemin vers la cle privee. La monter en volume ou en secret Docker plutot
# que de l'inclure dans l'image.
PAWAPAY_SIGNING_KEY_PATH=
# Variante : cle en ligne, retours a la ligne echappes en \n.
PAWAPAY_SIGNING_KEY=
# Identifiant affiche dans le dashboard pawaPay au televersement de la cle.
PAWAPAY_SIGNING_KEY_ID=
# ecdsa-p256-sha256 | ecdsa-p384-sha384 | rsa-pss-sha512 | rsa-v1_5-sha256
PAWAPAY_SIGNING_ALGORITHM=ecdsa-p256-sha256

# ─── Chiffrement / signature ────────────────────────────────────────────────
# Sel utilise pour hacher les cles API des projets clients. NE JAMAIS CHANGER
# apres creation des cles : toutes les cles existantes deviendraient invalides.
API_KEY_SALT=changer-cette-valeur-en-production

# Cle d'administration autorisant l'enrolement de nouveaux projets par HTTP
# (POST /v1/projects). Laissee vide, la creation de projet est refusee : un
# endpoint ouvert laisserait n'importe qui declencher des mouvements de fonds
# sur le compte marchand.
ADMIN_API_KEY=

# ─── Reconciliation ─────────────────────────────────────────────────────────
# Age minimal (minutes) d'une transaction en attente avant re-verification
RECONCILE_AFTER_MINUTES=15
# Nombre max de tentatives de livraison d'un webhook sortant
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
